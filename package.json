{
  "name": "ascii-tree-reorg-desktop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc -b && vite build",
    "build:desktop": "npm run build:ui && tsc -p desktop/electron/tsconfig.json",
    "test:ui": "vitest run",
    "preview": "vite preview",
    "start:desktop": "npm run build:desktop && electron .",
    "package": "npm run build:desktop && electron-builder --dir",
    "package:release": "npm run build:desktop && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "typescript": "7.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.3",
    "vitest": "5.0.1",
    "jsdom": "30.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.matanboaz.asciitreereorg",
    "productName": "Canopy",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-sidecar",
        "to": "desktop-sidecar"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "description": "Safe bidirectional ASCII tree workspace desktop app",
  "author": "Boaz Matan"
}
